# Copy this file to .dev.vars for `npm run dev:full`.
ADMIN_EMAIL=admin@example.com
# Lowercase SHA-256 of the administrator password.
ADMIN_PASSWORD_HASH=replace_with_sha256_hex
# At least 32 random characters. Used to sign admin and user session cookies.
SESSION_SECRET=replace_with_a_long_random_value
PUBLIC_SITE_URL=http://127.0.0.1:8788
